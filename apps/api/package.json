    "csv-parse": "6.1.0",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "prisma": "6.19.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
