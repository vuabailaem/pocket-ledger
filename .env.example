# Generate each independently: openssl rand -hex 32
OWNER_TOKEN=
SEPAY_WEBHOOK_KEY=
POSTGRES_PASSWORD=
DOMAIN=finance.example.com

# Published bind address for the API container.
# 127.0.0.1 (default) = this computer only.
# 0.0.0.0 = reachable on your LAN, e.g. for Expo Go on an iPhone. Trusted networks only:
# the owner token is sent in clear text unless you put it behind the https profile.
API_BIND=127.0.0.1
